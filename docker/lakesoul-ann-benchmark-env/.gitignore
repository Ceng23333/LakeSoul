# Ignore files starting with a dot
.*

# But not .gitignore itself
!.gitignore

# Common Python-related files to ignore
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/

# IDE-specific files
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints

# Logs
*.log

# Local configuration files
*.local

# Project-specific directories
packages/
data/embeddings/
data/minio/
fashion-mnist-784-euclidean.hdf5

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db 